# 必填：DeepSeek 开放平台密钥（只放服务端，不要写进前端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# 可选：模型名。默认值已经适合本项目。
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 可选：部署初期设为 true，可在 Vercel 日志查看缓存命中率；稳定后改回 false
DEEPSEEK_CACHE_DEBUG=false

# 必填：用于无数据库降级模式的服务端加密。建议至少32字节随机字符串。
SESSION_SECRET=

# 云端旧档案与游戏存档（Supabase）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：每天最多允许调用多少次AI，默认1000
DAILY_AI_LIMIT=1000
