# 必填：DeepSeek 开放平台密钥（只放服务端，不要写进前端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# 可选：模型名。默认值已经适合本项目。
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 部署初期设为 true，可在 Vercel 日志查看缓存命中率；稳定后改回 false
DEEPSEEK_CACHE_DEBUG=true

# 可选：用于数据库短暂不可用时的状态加密。
# 不填时会安全地从 DEEPSEEK_API_KEY 派生加密密钥。
SESSION_SECRET=

# 云端旧档案与游戏存档（Supabase）
SUPABASE_URL=
# 推荐：Supabase 新版服务端 Secret key（sb_secret_...）
SUPABASE_SECRET_KEY=
# 兼容旧项目：legacy service_role JWT；二选一即可
SUPABASE_SERVICE_ROLE_KEY=

# 费用保险：全站每日最多调用 AI 150 次，约 30 个完整五阶段游戏。
# 达到上限后自动切换本地导演，玩家仍能完整游玩。
DAILY_AI_LIMIT=150
# 单设备每日最多调用 AI 80 次，防止单个设备刷完余额。
DEVICE_DAILY_AI_LIMIT=80
